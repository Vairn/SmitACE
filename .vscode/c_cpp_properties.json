{
    "configurations": [
        {
            "name": "Amiga",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [
                "__GNUC__=8",
                "_NO_INLINE",
                "AMIGA"
            ],
            "compilerPath": "${default}",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x86",
            "configurationProvider": "BartmanAbyss.amiga-debug"
        },
        {
            "name": "Native",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/include",
                "${workspaceFolder}/deps/ACE/include",
                "${workspaceFolder}/deps/ACE/host/include"
            ],
            "defines": [
                "_DEBUG",
                "AMIGA",
                "ACE_HOST",
                "ACE_DEBUG",
                "ACE_HOST_DEBUG",
                "ACE_USE_AGA_FEATURES",
                "ACE_USE_ECS_FEATURES"
            ],
            "compilerPath": "C:/msys64/ucrt64/bin/gcc.exe",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        },
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/deps/ACE/include"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "AMIGA",
                "ACE_DEBUG",
                "ACE_DEBUG_UAE",
                "__CODE_CHECKER__"
            ],
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x86",
            "browse": {
                "path": [
                    "${workspaceFolder}"
                ],
                "databaseFilename": "${workspaceFolder}/.vscode/symbols.db",
                "limitSymbolsToIncludedHeaders": true
            },
            "configurationProvider": "vector-of-bool.cmake-tools"
        }
    ],
    "version": 4
}