{
	// See https://go.microsoft.com/fwlink/?LinkId=733558
	// for the documentation about the tasks.json format
	"version": "2.0.0",
	"tasks": [
		{
			"label": "debug game",
			"type": "shell",
			"command": "cmake",
			"group": "build",
			"args": [
				"..",
				"-DACE_DEBUG=ON",
				"-DGAME_DEBUG=ON",
				"-DGAME_DEBUG_AI=OFF",
				"-DACE_DEBUG_PTPLAYER=ON"
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": []
		},
		{
			"label": "debug game+ai",
			"type": "shell",
			"command": "cmake",
			"group": "build",
			"args": [
				"..",
				"-DACE_DEBUG=ON",
				"-DGAME_DEBUG=ON",
				"-DGAME_DEBUG_AI=ON",
				"-DACE_DEBUG_PTPLAYER=ON"
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": []
		},
		{
			"label": "debug off",
			"type": "shell",
			"command": "cmake",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"args": [
				"..",
				"-DACE_DEBUG=OFF",
				"-DGAME_DEBUG=OFF",
				"-DGAME_DEBUG_AI=OFF",
				"-DACE_DEBUG_PTPLAYER=OFF"
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": []
		},
		{
			"label": "configure native",
			"type": "shell",
			"command": "cmake",
			"group": "build",
			"args": [
				"-S",
				"${workspaceFolder}",
				"-B",
				"${workspaceFolder}/build/Native",
				"-G",
				"Ninja",
				"-DACE_HOST=ON",
				"-DACE_DEBUG=ON",
				"-DACE_DEBUG_UAE=ON",
				"-DACE_HOST_DEBUG=ON",
				"-DCMAKE_BUILD_TYPE=Debug",
				"-DCMAKE_PREFIX_PATH=C:/msys64/ucrt64",
				"-DCMAKE_C_COMPILER=C:/msys64/ucrt64/bin/gcc.exe"
			],
			"options": {
				"env": {
					"PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
				}
			},
			"problemMatcher": []
		},
		{
			"label": "build native",
			"type": "shell",
			"command": "cmake",
			"group": "build",
			"dependsOn": ["configure native"],
			"args": [
				"--build",
				"${workspaceFolder}/build/Native",
				"--parallel"
			],
			"options": {
				"env": {
					"PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
				}
			},
			"problemMatcher": ["$gcc"]
		}
	]
}
